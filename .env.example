# Sotuvchi AI — sozlamalar namunasi.
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.

# ─── Server ───────────────────────────────────────────────
PORT=8080
HOST=127.0.0.1
DEBUG=True

# ─── Ma'lumotlar bazasi (Postgres 17 + pgvector) ─────────
# Mahalliy: ./setup_postgres.sh skripti bazani tayyorlaydi
DATABASE_URL=postgresql+asyncpg://USER@localhost:5432/sotuvchi_ai

# ─── AI (Gemini) ──────────────────────────────────────────
# Kalit: https://aistudio.google.com/apikey  (AIza... bilan boshlanadi)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# flash-lite standart: bir suhbat 2+ so'rov yeydi, bepul tarifda limit qattiq
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=text-embedding-004
EMBED_DIM=768

# ─── Telegram ─────────────────────────────────────────────
# MUHIM: bot tokeni bu yerda emas — har bir biznes o'z tokenini
# panelning "Integratsiyalar" bo'limidan ulaydi (bazada saqlanadi).
#
# Localhost: polling avtomatik yoqiladi (PUBLIC_BASE_URL bo'sh bo'lsa),
# shuning uchun tunnel yoki deploy kerak emas.
# Ishlab chiqarishda: PUBLIC_BASE_URL ni qo'ying va TELEGRAM_POLLING=false qiling.
PUBLIC_BASE_URL=
# TELEGRAM_POLLING=true

# ─── AI xarajati (dashboard "AI xarajati" paneli) ─────────
# Provayder narx sahifasidan oling, 1M token uchun USD da.
# Bo'sh qoldirilsa panel faqat token sonini ko'rsatadi — noto'g'ri
# narxdan chiqqan ishonchli ko'rinishdagi son bundan yomonroq.
AI_PRICE_INPUT_PER_1M=
AI_PRICE_OUTPUT_PER_1M=
# UZS da ko'rsatish uchun joriy kurs
USD_TO_UZS=

# Dashboard davrlari ("bugun", "shu oy") shu siljish bo'yicha hisoblanadi.
# O'zbekiston yil bo'yi UTC+5, yozgi vaqt yo'q.
TIMEZONE_OFFSET_HOURS=5

# ─── Google Sheets (ixtiyoriy) ────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=service_account.json
