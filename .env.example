# Sotuvchi AI — sozlamalar namunasi.
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.

# ─── Server ───────────────────────────────────────────────
PORT=8080
HOST=127.0.0.1
DEBUG=True

# ─── Ma'lumotlar bazasi (Postgres 17 + pgvector) ─────────
# Mahalliy: ./setup_postgres.sh skripti bazani tayyorlaydi
DATABASE_URL=postgresql+asyncpg://USER@localhost:5432/sotuvchi_ai

# ─── AI ───────────────────────────────────────────────────
# Har bir biznes qaysi model bilan ishlashini bosh admin panelidan tanlaydi.
# Tanlov faqat kaliti shu yerda turgan provayderlar orasidan qilinadi —
# kalitsiz provayder ro'yxatda "kalit yo'q" deb ko'rinadi va saqlanmaydi.
AI_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/apikey  (AIza... bilan boshlanadi)
GEMINI_API_KEY=
# flash-lite standart: bir suhbat 2+ so'rov yeydi, bepul tarifda limit qattiq
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=text-embedding-004
EMBED_DIM=768

# Anthropic Claude — https://console.anthropic.com/settings/keys  (sk-ant-...)
ANTHROPIC_API_KEY=
# OpenAI ChatGPT — https://platform.openai.com/api-keys  (sk-...)
OPENAI_API_KEY=

# ─── Telegram ─────────────────────────────────────────────
# MUHIM: bot tokeni bu yerda emas — har bir biznes o'z tokenini
# panelning "Integratsiyalar" bo'limidan ulaydi (bazada saqlanadi).
#
# Localhost: polling avtomatik yoqiladi (PUBLIC_BASE_URL bo'sh bo'lsa),
# shuning uchun tunnel yoki deploy kerak emas.
# Ishlab chiqarishda: PUBLIC_BASE_URL ni qo'ying va TELEGRAM_POLLING=false qiling.
PUBLIC_BASE_URL=
# TELEGRAM_POLLING=true

# ─── AI xarajati (dashboard "AI xarajati" paneli) ─────────
# Provayder narx sahifasidan oling, 1M token uchun USD da.
# Bo'sh qoldirilsa panel faqat token sonini ko'rsatadi — noto'g'ri
# narxdan chiqqan ishonchli ko'rinishdagi son bundan yomonroq.
AI_PRICE_INPUT_PER_1M=
AI_PRICE_OUTPUT_PER_1M=
# UZS da ko'rsatish uchun joriy kurs
USD_TO_UZS=

# Dashboard davrlari ("bugun", "shu oy") shu siljish bo'yicha hisoblanadi.
# O'zbekiston yil bo'yi UTC+5, yozgi vaqt yo'q.
TIMEZONE_OFFSET_HOURS=5

# ─── Google Sheets (ixtiyoriy) ────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=service_account.json

# ─── Obyekt xotirasi (MUHIM) ──────────────────────────────
# Bo'sh qoldirilsa rasmlar konteyner diskiga yoziladi va HAR QAYTA
# JOYLASHTIRISHDA YO'QOLADI. Har qanday S3-mos xizmat ishlaydi:
# AWS S3, Cloudflare R2, Backblaze B2, Supabase Storage.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Brauzer rasmni shu manzildan oladi (CDN domeni yoki bucket'ning ochiq URL'i)
S3_PUBLIC_URL=

# ─── Sirlarni shifrlash (MUHIM) ───────────────────────────
# Telegram bot tokenlari bazada shu kalit bilan shifrlanadi.
# Yaratish:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DIQQAT: kalit yo'qolsa tokenlarni ochib bo'lmaydi — har bir biznes
# botini qaytadan ulashiga to'g'ri keladi. Baza parolini qayerda saqlasangiz,
# bu kalitni BOSHQA joyda saqlang.
ENCRYPTION_KEY=

# ─── Xatolarni kuzatish (ixtiyoriy, lekin tavsiya etiladi) ─
# Bo'sh qoldirilsa xatolar faqat stdout'ga yoziladi va prodda nimadir
# buzilganini birinchi bo'lib mijoz aytadi.
SENTRY_DSN=
ENVIRONMENT=development

# ─── Proksi ishonchi ──────────────────────────────────────
# '*' — hosting proksisining manzili noma'lum bo'lganda. Bu holda
# X-Forwarded-For'ni soxtalashtirish mumkin, shuning uchun parol tanlashga
# qarshi asosiy himoya hisob darajasidagi qulf (app/core/security.py).
# Proksi manzili ma'lum bo'lsa shu yerga yozing.
FORWARDED_ALLOW_IPS=*

