# Sotuvchi AI - Sozlamalar va API Kalitlar

# Server sozlamalari
PORT=8000
HOST=0.0.0.0
DEBUG=True

# AI Model sozlamalari (Gemini yoki Anthropic API Key kiriting)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_PROVIDER=gemini # gemini yoki anthropic

# Telegram Bot Token (BotFather-dan olingan token)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/bot/webhook

# Google Sheets CRM Sozlamalari
# Service Account JSON fayli yo'li yoki Google Sheet ID
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheet_id_here
GOOGLE_SHEETS_CREDENTIALS_FILE=service_account.json
